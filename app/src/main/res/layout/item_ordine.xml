<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_margin="8dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/dataTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Ordine in data:"
            android:textStyle="bold"
            android:textColor="@android:color/holo_orange_light"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/descrizioneTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Descrizione: ..."
            android:textSize="18sp"
            android:layout_marginTop="24dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/totaleTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Totale: ..."
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/tipoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:textColor="@android:color/black"
            android:text="Tipo: Ordine al tavolo/d'asporto" />

        <TextView
            android:id="@+id/nomeTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Nome:"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/telefonoTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Telefono:"
            android:textColor="@android:color/black"
            android:textSize="18sp"
            android:visibility="gone" />


        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/textViewStatoOrdine"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Stato:"
                android:textSize="16sp"
                android:textColor="@android:color/black"
                android:layout_marginEnd="8dp"/>

            <ImageView
                android:id="@+id/imageViewStatoOrdine"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/clessidra"
                android:visibility="gone" />

        </LinearLayout>

        <TextView
            android:id="@+id/tavoloOrarioTextView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:layout_marginTop="8dp"
            android:textStyle="bold"
            android:textColor="@android:color/black"
            android:text="Tavolo: /Ora di ritiro:" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
